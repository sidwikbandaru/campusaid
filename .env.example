# AWS Configuration for CampusAid AI
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional session token if using AWS IAM Identity Center or STS:
# AWS_SESSION_TOKEN=your_session_token

# Amazon Bedrock Settings
# Recommended models:
# - anthropic.claude-3-sonnet-20240229-v1:0
# - anthropic.claude-3-5-sonnet-20240620-v1:0
# - anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Amazon DynamoDB Table Names
DYNAMODB_STUDY_SESSIONS_TABLE=CampusAid_StudySessions
DYNAMODB_ROADMAPS_TABLE=CampusAid_Roadmaps
DYNAMODB_INTERVIEW_SESSIONS_TABLE=CampusAid_InterviewSessions
DYNAMODB_SKILLS_TABLE=CampusAid_Skills
DYNAMODB_STUDENTS_TABLE=CampusAid_Students
